<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="true" showFlags="Date, Time, Size, Extension, LongDate" />
        
        <!-- Remove WebDAV to prevent conflicts -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        
        <!-- ============================================
            CRITICAL: FastCGI Settings - INCREASED TO 4 HOURS
            - activityTimeout: 14400 seconds (4 hours)
            - requestTimeout: 14400 seconds (4 hours)
            - Supports files up to 500MB
            ============================================ -->
        <fastCgi>
            <application fullPath="C:\php-8.1.23-Win32-vs16-x64\php-cgi.exe" 
                    activityTimeout="14400" 
                        requestTimeout="14400" 
                        instanceMaxRequests="10000"
                        protocol="NamedPipe" 
                        flushNamedPipe="False"
                        monitorChangesTo="C:\php-8.1.23-Win32-vs16-x64\php.ini"
                        maxInstances="4"
                        idleTimeout="600"
                        rapidFailsPerMinute="10"
                        signalBeforeTerminateSeconds="30">
                <environmentVariables>
                    <environmentVariable name="PHP_FCGI_MAX_REQUESTS" value="10000" />
                    <environmentVariable name="PHPRC" value="C:\php-8.1.23-Win32-vs16-x64" />
                </environmentVariables>
            </application>
        </fastCgi>
        
        <!-- PHP Handler with 4-hour timeout -->
        <handlers>
            <remove name="WebDAV" />
            <remove name="PHP_via_FastCGI" />
            <add name="PHP_via_FastCGI" 
                path="*.php" 
                verb="GET,HEAD,POST,PUT,DELETE,OPTIONS,PATCH" 
                modules="FastCgiModule" 
                scriptProcessor="C:\php-8.1.23-Win32-vs16-x64\php-cgi.exe" 
                resourceType="Either" 
                requireAccess="Script" 
                requestTimeout="04:00:00" 
                responseBufferLimit="0" />
        </handlers>
        
        <!-- Static Content MIME Types -->
        <staticContent>
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>
        
        <!-- URL Rewrite Rules -->
        <rewrite>
            <rules>
                <!-- Redirect to public folder -->
                <rule name="Public Folder" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_URI}" pattern="^public" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:1}" />
                </rule>
                
                <!-- Laravel Routing -->
                <rule name="Laravel Routes" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/index.php" />
                </rule>
            </rules>
        </rewrite>
        
        <!-- Security and Upload Settings -->
        <security>
            <requestFiltering allowDoubleEscaping="false">
                <!-- Allow large file uploads (500MB = 524,288,000 bytes) -->
                <requestLimits maxAllowedContentLength="524288000" 
                            maxUrl="4096" 
                            maxQueryString="2048" />
                
                <!-- Allow common file extensions -->
                <fileExtensions>
                    <add fileExtension=".csv" allowed="true" />
                    <add fileExtension=".txt" allowed="true" />
                </fileExtensions>
            </requestFiltering>
        </security>
        
        <!-- HTTP Protocol Settings -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="X-XSS-Protection" value="1; mode=block" />
            </customHeaders>
        </httpProtocol>
        
        <!-- Default Document -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="index.html" />
            </files>
        </defaultDocument>
        
        <!-- URL Compression -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        
        <!-- Server-side settings for large requests -->
        <serverRuntime enabled="true" 
                    frequentHitThreshold="1" 
                    frequentHitTimePeriod="00:00:10" 
                    uploadReadAheadSize="49152"
                    maxRequestEntityAllowed="524288000" />
        
        <!-- HTTP Errors -->
        <httpErrors errorMode="Detailed" />
    </system.webServer>
    
    <!-- System.Web settings -->
    <system.web>
        <!-- 4 hour execution timeout -->
        <httpRuntime executionTimeout="14400" 
                    maxRequestLength="512000" 
                    requestLengthDiskThreshold="512000"
                    enableVersionHeader="false"
                    requestValidationMode="2.0" />
        
        <!-- Session state -->
        <sessionState timeout="240" />
        
        <!-- Compilation settings -->
        <compilation debug="false" targetFramework="4.8" />
    </system.web>
    
    <!-- Application Settings -->
    <appSettings>
        <add key="aspnet:MaxJsonDeserializerMembers" value="150000" />
        <add key="aspnet:MaxHttpCollectionKeys" value="10000" />
    </appSettings>
    
    <!-- Location-specific settings for import routes -->
    <location path="public/imports">
        <system.webServer>
            <security>
                <requestFiltering>
                    <!-- 1GB for import endpoint -->
                    <requestLimits maxAllowedContentLength="1073741824" />
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
</configuration>