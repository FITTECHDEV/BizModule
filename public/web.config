<configuration>
<system.webServer>
  <httpErrors errorMode="Detailed" />
        <defaultDocument>
            <files>
                <add value="index.php" />
            </files>
        </defaultDocument>
        <staticContent>
            <mimeMap fileExtension=".php" mimeType="text/x-php" />
        </staticContent>
        <handlers>
            <remove name="PHP Via FastCGI" />
            <add name="PHP Via FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\php-8.1.23-Win32-vs16-x64\php-cgi.exe" resourceType="File" />
        </handlers>
</system.webServer>

  <system.webServer>
    <security>
      <requestFiltering>
       <fileExtensions allowUnlisted="true">
      <remove fileExtension="." />
      <add fileExtension="." allowed="true" />
    </fileExtensions>
                <requestLimits maxAllowedContentLength="300000000" maxQueryString="4096" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Redirect to Trailing Slash" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="{R:1}/" />
        </rule>
        <rule name="Rewrite to index.php" stopProcessing="true">
          <match url="^(?!index\.php).*" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
