<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    
    <!-- HTTP Error Handling -->
    <httpErrors errorMode="Detailed" />
    
    <!-- Default Document -->
    <defaultDocument>
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>
    
    <!-- PHP Handler Configuration -->
    <handlers>
      <remove name="PHP Via FastCGI" />
      <add name="PHP Via FastCGI" 
          path="*.php" 
          verb="*" 
          modules="FastCgiModule" 
          scriptProcessor="C:\php-8.1.23-Win32-vs16-x64\php-cgi.exe" 
          resourceType="File" 
          requireAccess="Script" />
    </handlers>
    
    <!-- Security & Request Filtering -->
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <remove fileExtension="." />
          <add fileExtension="." allowed="true" />
        </fileExtensions>
        <!-- 300MB max upload (for large CSV files) -->
        <requestLimits maxAllowedContentLength="314572800" maxQueryString="4096" />
      </requestFiltering>
    </security>
    
    <!-- URL Rewrite Rules -->
    <rewrite>
      <rules>
        <rule name="Redirect to Trailing Slash" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="{R:1}/" />
        </rule>
        <rule name="Rewrite to index.php" stopProcessing="true">
          <match url="^(?!index\.php).*" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/fit/" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
    
  </system.webServer>
</configuration>