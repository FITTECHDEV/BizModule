{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "academe/laravel-azure-file-storage-driver": "^0.3.0",
        "adldap2/adldap2-laravel": "^6.1",
        "barryvdh/laravel-dompdf": "^1.0",
        "consoletvs/charts": "^6.5",
        "elibyy/tcpdf-laravel": "^9.3",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "genealabs/laravel-model-caching": "^0.11.3",
        "guzzlehttp/guzzle": "^7.5",
        "htmlmin/htmlmin": "^8.0",
        "jeroennoten/laravel-adminlte": "^3.15",
        "jimmyjs/laravel-report-generator": "^2.1",
        "juliomotol/laravel-auth-timeout": "^3.0",
        "laravel-notification-channels/webpush": "^5.1",
        "laravel/framework": "^8.40",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.3",
        "laravelcollective/html": "^6.2",
        "pusher/pusher-php-server": "^7.0",
        "rap2hpoutre/laravel-log-viewer": "^2.2",
        "realrashid/sweet-alert": "^4.0",
        "renatomarinho/laravel-page-speed": "^2.0",
        "rootinc/laravel-azure-middleware": "^0.9.10",
        "spatie/laravel-permission": "^4.2",
        "steffjenl/laravel-azure-blob-storage": "^1.0",
        "sudiptpa/guid": "^1.0",
        "webpatser/laravel-uuid": "*",
        "yajra/laravel-datatables-oracle": "^9.18"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "barryvdh/laravel-ide-helper": "^2.13",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.20",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3",
        "supliu/laravel-query-monitor": "^1.0",
        "sven/artisan-view": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
